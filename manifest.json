{
  "manifest_version": 3,
  "name": "WebEdit AI",
  "version": "0.3.1",
  "description": "Visually edit any website – hide, customize or add elements with AI assistance.",
  "action": {
    "default_title": "WebEdit AI - Click to toggle panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://eqfjkvjwsswjxkmomxax.supabase.co/*",
    "https://webeditai.com/*",
    "https://www.webeditai.com/*",
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "contextExtractor.js",
        "contentScript.js"
      ],
      "css": [
        "contentStyles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}