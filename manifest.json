{
  "manifest_version": 3,
  "name": "WebEdit AI",
  "version": "0.3.1",
  "description": "Visually edit any website – hide, customize or add elements with AI assistance.",
  "action": {
    "default_title": "WebEdit AI - Click to toggle panel",
    "default_icon": {
      "16": "Logo/favicon16.png",
      "32": "Logo/favicon32.png",
      "48": "Logo/favicon48.png",
      "128": "Logo/favicon128.png"
    }
  },
  "icons": {
    "16": "Logo/favicon16.png",
    "32": "Logo/favicon32.png",
    "48": "Logo/favicon48.png",
    "128": "Logo/favicon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ], 
  "host_permissions": [
    "https://eqfjkvjwsswjxkmomxax.supabase.co/*",
    "https://webeditai.com/*",
    "https://www.webeditai.com/*",
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://webeditai.com/*",
        "https://www.webeditai.com/*"
      ],
      "js": [
        "bridge-listener.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "contextExtractor.js",
        "contentScript.js",
        "features/remove-hands.js",
        "features/customize-hands.js",
        "features/add-hands.js"
      ],
      "css": [
        "contentStyles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}