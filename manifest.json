{
  "manifest_version": 3,
  "name": "WebEdit AI",
  "version": "0.3.0",
  "description": "Visually edit any website – hide, customize or add elements with AI assistance.",
  "action": {
    "default_title": "WebEdit AI - Click to toggle panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "Logo/favicon16.png",
    "32": "Logo/favicon32.png",
    "48": "Logo/favicon48.png",
    "128": "Logo/favicon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}